# Copy to .env and fill in the values. Never commit .env.
DATABASE_URL=
PAYLOAD_SECRET=
# End-to-end tests (npm run test:e2e) refuse to run unless DATABASE_URL's host equals this.
# Set it to the DEV database host only, never the live one.
E2E_DATABASE_HOST=
# Rate limits: set to the header your host guarantees contains the real client IP (check the
# host's documentation). Leave empty until deployment. While empty, production applies one
# site-wide safety limit instead of per-visitor limits.
TRUSTED_IP_HEADER=
